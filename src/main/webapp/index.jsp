<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>UniLib | Online Library</title>

    <link rel="stylesheet" href="css/style.css">
</head>

<body>

<!-- ================= NAVBAR ================= -->

<header class="navbar">

    <div class="logo-area">

        <div class="logo-icon">
            📖
        </div>

        <div class="logo-text">
            <span>Uni</span>Lib
        </div>

    </div>

    <nav class="nav-links">

        <a href="index.jsp" class="active">Home</a>

        <a href="#">Books</a>

    </nav>

    <div class="nav-actions">

        <a href="login.jsp" class="login-link">
            Login
        </a>

        <a href="register.jsp" class="register-button">
            Register
        </a>

    </div>

</header>


<!-- ================= HERO ================= -->

<section class="hero">

    <div class="hero-content">

        <div class="hero-label">
            ONLINE LIBRARY MANAGEMENT SYSTEM
        </div>

        <h1>
            Your Library,
            <span>Simplified.</span>
        </h1>

        <p>
            Search, borrow and manage your books
            from one simple platform.
        </p>

        <div class="hero-buttons">

            <a href="#" class="primary-button">
                Explore Books
            </a>

            <a href="login.jsp" class="secondary-button">
                Login
            </a>

        </div>

    </div>


    <!-- Book Illustration -->

    <div class="book-display">

        <div class="books">

            <div class="book book-one"></div>

            <div class="book book-two"></div>

            <div class="book book-three"></div>

            <div class="book book-four"></div>

            <div class="book book-five"></div>

        </div>

        <div class="book-shelf"></div>

        <p class="quote">
            "A reader lives a thousand lives
            before he dies."
        </p>

        <p class="author">
            — George R. R. Martin
        </p>

    </div>

</section>


<!-- ================= FEATURES ================= -->

<section class="features">

    <div class="feature-card">

        <div class="feature-icon">
            📚
        </div>

        <h3>
            Search Books
        </h3>

        <p>
            Find books in the catalog
            by title, author or genre.
        </p>

    </div>


    <div class="feature-card">

        <div class="feature-icon">
            📖
        </div>

        <h3>
            Borrow & Return
        </h3>

        <p>
            Borrow available books and
            return them when you're done.
        </p>

    </div>


    <div class="feature-card">

        <div class="feature-icon">
            🕒
        </div>

        <h3>
            Track History
        </h3>

        <p>
            Keep track of your borrowed
            books and due dates.
        </p>

    </div>


    <div class="feature-card">

        <div class="feature-icon">
            🔔
        </div>

        <h3>
            Stay Updated
        </h3>

        <p>
            Get notifications about
            due dates and new books.
        </p>

    </div>

</section>


<!-- ================= FOOTER ================= -->

<footer class="footer">

    <p>
        UniLib — Online Library Management System
    </p>

    <p>
        B.Tech CSE Project
    </p>

</footer>

</body>
</html>